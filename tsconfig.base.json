{
  "compilerOptions": {
    // === Базовые настройки ===
    "target": "ES2020",
    "lib": ["ES2020"],
    "jsx": "react-jsx",

    // === Строгость и качество ===
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUnusedLocals": false, // можно включить при желании
    "noUnusedParameters": false, // можно включить при желании

    // === Совместимость и сборка ===
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true, // необходимо для Vite, Expo, SWC
    "verbatimModuleSyntax": true, // современная альтернатива isolatedModules
    "moduleDetection": "force",

    // === Декларации для библиотек ===
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    // === Project References (опционально) ===
    "composite": true,
    "incremental": true
  },
  "exclude": ["node_modules", "dist", "build", ".turbo", "coverage"]
}
