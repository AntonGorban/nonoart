{
  "singleQuote": true,
  "printWidth": 120,
  "semi": true,
  "trailingComma": "all",
  "tabWidth": 2,
  "useTabs": false,
  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "always",
  "endOfLine": "lf",

  "plugins": ["@trivago/prettier-plugin-sort-imports"],

  "importOrder": [
    "<BUILTIN_MODULES>",
    "<TYPES>",
    "^[^@.]",
    "^@(?!/)(?!nono-art)",
    "^@nono-art/",
    "^.*\\.(svg|png|jpe?g|webp|gif|ico|bmp|tiff)$",
    ".*(?<!\\.module)\\.(css|scss)$",
    ".*\\.module\\.(css|scss)$",
    "^@/",
    "^\\.\\./",
    "^\\./",
    "<THIRD_PARTY_MODULES>"
  ],
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true,
  "importOrderGroupNamespaceSpecifiers": true,
  "importOrderCaseInsensitive": true,
  "importOrderParserPlugins": ["typescript", "jsx", "decorators-legacy"]
}
