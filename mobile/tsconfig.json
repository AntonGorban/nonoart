{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "jsx": "react-native",
    "types": [
      "react-native"
    ],
    "strict": true,
    "moduleResolution": "bundler",
    "incremental": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".expo",
    "ios",
    "android"
  ],
  "references": [
    {
      "path": "../libs/api"
    },
    {
      "path": "../libs/api-types"
    },
    {
      "path": "../libs/dal"
    },
    {
      "path": "../libs/domain"
    },
    {
      "path": "../libs/types"
    },
    {
      "path": "../libs/ui-web"
    },
    {
      "path": "../libs/utils"
    },
    {
      "path": "../libs/validation"
    }
  ]
}
