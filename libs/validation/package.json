{
  "name": "@nono-art/validation",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.13.0",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc --build --watch --preserveWatchOutput",
    "clean": "rm -rf dist",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit --preserveWatchOutput",
    "typecheck:watch": "yarn typecheck --watch"
  },
  "dependencies": {
    "@nono-art/domain": "workspace:^",
    "@nono-art/types": "workspace:^",
    "@nono-art/utils": "workspace:^"
  },
  "peerDependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.0"
  }
}
