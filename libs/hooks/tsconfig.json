{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "incremental": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo",
    "lib": ["ESNext"],
    "types": []
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test"]
}
