{
  "name": "nono-art",
  "private": true,
  "packageManager": "yarn@4.13.0",
  "workspaces": [
    "server",
    "mobile",
    "site",
    "libs/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "clean": "turbo run clean",
    "lint": "turbo run lint",
    "format:check": "prettier -c .",
    "format": "prettier -w .",
    "typecheck": "turbo run typecheck",
    "docker:dev": "yarn docker:dev:down && yarn docker:dev:up -d && yarn docker:dev:logs",
    "docker:dev:up": "docker compose -f compose.dev.yml up",
    "docker:dev:logs": "docker compose -f compose.dev.yml logs -f",
    "docker:dev:down": "docker compose -f compose.dev.yml down",
    "docker:dev:clear": "docker compose -f compose.dev.yml down -v"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "prettier": "^3.8.1",
    "turbo": "^2.9.3",
    "typescript": "^5.9.3"
  }
}
