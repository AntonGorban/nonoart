{
  "name": "nono-art",
  "private": true,
  "packageManager": "yarn@4.13.0",
  "workspaces": [
    "server",
    "mobile",
    "site",
    "libs/*"
  ],
  "scripts": {
    "/* ----------------------------------- dev ---------------------------------- */": "",
    "dev": "turbo run dev",
    "dev:apps": "turbo run dev --filter=\"./{server,site,mobile}\"",
    "dev:server": "yarn workspace server run dev",
    "dev:server:libs": "turbo run dev --filter=server^...",
    "dev:server:with-libs": "turbo run dev --filter=server...",
    "dev:site": "yarn workspace site run dev",
    "dev:site:libs": "turbo run dev --filter=site^...",
    "dev:site:with-libs": "turbo run dev --filter=site...",
    "dev:mobile": "yarn workspace mobile run dev",
    "dev:mobile:libs": "turbo run dev --filter=mobile^...",
    "dev:mobile:with-libs": "turbo run dev --filter=mobile...",
    "dev:libs": "turbo run dev --filter=\"./libs/*\"",
    "dev:lib:api": "turbo run dev --filter=@nono-art/api...",
    "dev:lib:api-types": "turbo run dev --filter=@nono-art/api-types...",
    "dev:lib:domain": "turbo run dev --filter=@nono-art/domain...",
    "dev:lib:types": "turbo run dev --filter=@nono-art/types...",
    "dev:lib:utils": "turbo run dev --filter=@nono-art/utils...",
    "dev:lib:validation": "turbo run dev --filter=@nono-art/validation...",
    "/* ---------------------------------- / dev --------------------------------- */": "",
    "/* ---------------------------------- build --------------------------------- */": "",
    "build": "turbo run build",
    "build:server": "turbo run build --filter=server...",
    "build:site": "turbo run build --filter=site...",
    "build:mobile": "turbo run build --filter=mobile...",
    "build:libs": "turbo run build --filter=\"./libs/*\"",
    "build:lib:api": "turbo run build --filter=@nono-art/api...",
    "build:lib:api-types": "turbo run build --filter=@nono-art/api-types...",
    "build:lib:domain": "turbo run build --filter=@nono-art/domain...",
    "build:lib:types": "turbo run build --filter=@nono-art/types...",
    "build:lib:utils": "turbo run build --filter=@nono-art/utils...",
    "build:lib:validation": "turbo run build --filter=@nono-art/validation...",
    "/* --------------------------------- / build -------------------------------- */": "",
    "/* ---------------------------------- start --------------------------------- */": "",
    "start": "turbo run start",
    "start:apps": "turbo run start --filter=\"./{server,site,mobile}\"",
    "start:server": "turbo run start --filter=server",
    "start:site": "turbo run start --filter=site",
    "start:mobile": "turbo run start --filter=mobile",
    "/* --------------------------------- / start -------------------------------- */": "",
    "/* -------------------------------- typecheck ------------------------------- */": "",
    "typecheck:watch": "turbo run typecheck:watch",
    "typecheck": "turbo run typecheck",
    "typecheck:apps:watch": "turbo run typecheck:watch --filter=\"./{server,site,mobile}\"",
    "typecheck:apps": "turbo run typecheck --filter=\"./{server,site,mobile}\"",
    "typecheck:server:watch": "turbo run typecheck:watch --filter=server",
    "typecheck:server": "turbo run typecheck --filter=server",
    "typecheck:site:watch": "turbo run typecheck:watch --filter=site",
    "typecheck:site": "turbo run typecheck --filter=site",
    "typecheck:mobile:watch": "turbo run typecheck:watch --filter=mobile",
    "typecheck:mobile": "turbo run typecheck --filter=mobile",
    "typecheck:libs:watch": "turbo run typecheck:watch --filter=\"./libs/*\"",
    "typecheck:libs": "turbo run typecheck --filter=\"./libs/*\"",
    "typecheck:lib:api:watch": "turbo run typecheck:watch --filter=@nono-art/api",
    "typecheck:lib:api": "turbo run typecheck --filter=@nono-art/api",
    "typecheck:lib:api-types:watch": "turbo run typecheck:watch --filter=@nono-art/api-types",
    "typecheck:lib:api-types": "turbo run typecheck --filter=@nono-art/api-types",
    "typecheck:lib:domain:watch": "turbo run typecheck:watch --filter=@nono-art/domain",
    "typecheck:lib:domain": "turbo run typecheck --filter=@nono-art/domain",
    "typecheck:lib:types:watch": "turbo run typecheck:watch --filter=@nono-art/types",
    "typecheck:lib:types": "turbo run typecheck --filter=@nono-art/types",
    "typecheck:lib:utils:watch": "turbo run typecheck:watch --filter=@nono-art/utils",
    "typecheck:lib:utils": "turbo run typecheck --filter=@nono-art/utils",
    "typecheck:lib:validation:watch": "turbo run typecheck:watch --filter=@nono-art/validation",
    "typecheck:lib:validation": "turbo run typecheck --filter=@nono-art/validation",
    "/* ------------------------------- / typecheck ------------------------------ */": "",
    "/* ---------------------------------- lint ---------------------------------- */": "",
    "lint": "turbo run lint",
    "lint:apps": "turbo run lint --filter=\"./{server,site,mobile}\"",
    "lint:server": "turbo run lint --filter=server",
    "lint:site": "turbo run lint --filter=site",
    "lint:mobile": "turbo run lint --filter=mobile",
    "lint:libs": "turbo run lint --filter=\"./libs/*\"",
    "lint:lib:api": "turbo run lint --filter=@nono-art/api",
    "lint:lib:api-types": "turbo run lint --filter=@nono-art/api-types",
    "lint:lib:domain": "turbo run lint --filter=@nono-art/domain",
    "lint:lib:types": "turbo run lint --filter=@nono-art/types",
    "lint:lib:utils": "turbo run lint --filter=@nono-art/utils",
    "lint:lib:validation": "turbo run lint --filter=@nono-art/validation",
    "/* --------------------------------- / lint --------------------------------- */": "",
    "/* --------------------------------- format --------------------------------- */": "",
    "format:check": "prettier -c .",
    "format": "prettier -w .",
    "/* -------------------------------- / format -------------------------------- */": "",
    "/* ---------------------------------- clean --------------------------------- */": "",
    "clean": "turbo run clean",
    "clean:apps": "turbo run clean --filter=\"./{server,site,mobile}\"",
    "clean:server": "turbo run clean --filter=server",
    "clean:site": "turbo run clean --filter=site",
    "clean:mobile": "turbo run clean --filter=mobile",
    "clean:libs": "turbo run clean --filter=\"./libs/*\"",
    "clean:lib:api": "turbo run clean --filter=@nono-art/api",
    "clean:lib:api-types": "turbo run clean --filter=@nono-art/api-types",
    "clean:lib:domain": "turbo run clean --filter=@nono-art/domain",
    "clean:lib:types": "turbo run clean --filter=@nono-art/types",
    "clean:lib:utils": "turbo run clean --filter=@nono-art/utils",
    "clean:lib:validation": "turbo run clean --filter=@nono-art/validation",
    "/* --------------------------------- / clean -------------------------------- */": "",
    "/* --------------------------------- docker --------------------------------- */": "",
    "docker:dev": "yarn docker:dev:down && yarn docker:dev:up -d && yarn docker:dev:logs",
    "docker:dev:up": "docker compose -f compose.dev.yml up",
    "docker:dev:logs": "docker compose -f compose.dev.yml logs -f",
    "docker:dev:down": "docker compose -f compose.dev.yml down",
    "docker:dev:clear": "docker compose -f compose.dev.yml down -v",
    "/* -------------------------------- / docker -------------------------------- */": ""
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "prettier": "^3.8.1",
    "turbo": "^2.9.3",
    "typescript": "^5.9.3"
  }
}
